<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- place-bin de Pick-and-Place (scene_icub_pickplace.xml): base 12x12 cm y paredes de 4 cm.
       Simetrico respecto de su origen, asi que el giro de 180 grados MuJoCo->Gazebo no lo cambia.
       Se coloca con el origen en z=0.72 (cara superior de la mesa). -->
  <model name="place-bin">
    <static>true</static>
    <link name="link">
      <collision name="base_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.12 0.12 0.005</size></box></geometry></collision>
      <visual name="base_vis"><pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.005</size></box></geometry>
        <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
      <collision name="wall1_col"><pose>0.0575 0 0.02 0 0 0</pose><geometry><box><size>0.005 0.12 0.04</size></box></geometry></collision>
      <visual name="wall1_vis"><pose>0.0575 0 0.02 0 0 0</pose>
        <geometry><box><size>0.005 0.12 0.04</size></box></geometry>
        <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
      <collision name="wall2_col"><pose>-0.0575 0 0.02 0 0 0</pose><geometry><box><size>0.005 0.12 0.04</size></box></geometry></collision>
      <visual name="wall2_vis"><pose>-0.0575 0 0.02 0 0 0</pose>
        <geometry><box><size>0.005 0.12 0.04</size></box></geometry>
        <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
      <collision name="wall3_col"><pose>0 0.0575 0.02 0 0 0</pose><geometry><box><size>0.12 0.005 0.04</size></box></geometry></collision>
      <visual name="wall3_vis"><pose>0 0.0575 0.02 0 0 0</pose>
        <geometry><box><size>0.12 0.005 0.04</size></box></geometry>
        <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
      <collision name="wall4_col"><pose>0 -0.0575 0.02 0 0 0</pose><geometry><box><size>0.12 0.005 0.04</size></box></geometry></collision>
      <visual name="wall4_vis"><pose>0 -0.0575 0.02 0 0 0</pose>
        <geometry><box><size>0.12 0.005 0.04</size></box></geometry>
        <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
