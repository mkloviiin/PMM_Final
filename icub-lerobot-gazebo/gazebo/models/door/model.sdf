<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- Puerta de Door Opening (scene_icub_door.xml): marco con dos montantes, panel con bisagra (door_hinge,
       0..1.5 rad) y manija soldada al panel. Generada desde la geometria
       compilada de MuJoCo y ya espejada al marco de Gazebo (giro de 180 grados en z). Los eslabones tienen
       orientacion identidad, asi que los ejes de las bisagras estan en ejes del mundo. El marco queda fijo al
       mundo. Se coloca en (-0.42, -0.15, 0.885) (en MuJoCo: door_mount en (0.42, 0.15, 0.885)). Al volver a
       crearla (reset) las bisagras vuelven a 0, como pide scenes.yaml. Manija con mu=5 como los cubos. La
       manija va SOLDADA al panel (junta fija): la puerta real no tiene pestillo ni mecanismo, la manija es solo
       un agarre. En MuJoCo, en cambio, existe handle_hinge (-1.2..0 rad, con resorte). -->
  <model name="door">
    <link name="door_frame">
      <pose>0 -0.121 0 0 0 0</pose>
      <inertial>
        <pose>-0.00013 0.165 0 0 0 0</pose>
        <mass>1.3</mass>
        <inertia><ixx>0.0465</ixx><ixy>3.02557e-05</ixy><ixz>0</ixz><iyy>0.00850002</iyy><iyz>0</iyz><izz>0.0385</izz></inertia>
      </inertial>
      <collision name="c0"><pose>-0.00024 0.30525 0 0 0 1.57159</pose><geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry></collision>
      <visual name="v0"><pose>-0.00024 0.30525 0 0 0 1.57159</pose><geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry><material><ambient>0.3 0.18 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material></visual>
      <collision name="c1"><pose>-0.00002 0.02475 0 0 0 1.57159</pose><geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry></collision>
      <visual name="v1"><pose>-0.00002 0.02475 0 0 0 1.57159</pose><geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry><material><ambient>0.3 0.18 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material></visual>
    </link>
    <link name="door_panel">
      <pose>-0.00013 0.044 0 0 0 0</pose>
      <inertial>
        <pose>0.00083 0.0163 0 0 0 0</pose>
        <mass>0.4</mass>
        <inertia><ixx>0.00459937</ixx><ixy>3.55802e-05</ixy><ixz>0</ixz><iyy>0.00260063</iyy><iyz>0</iyz><izz>0.0022</izz></inertia>
      </inertial>
      <collision name="c2"><pose>0 0 0 0 0 1.57159</pose><geometry><box><size>0.242 0.022 0.319</size></box></geometry></collision>
      <visual name="v2"><pose>0 0 0 0 0 1.57159</pose><geometry><box><size>0.242 0.022 0.319</size></box></geometry><material><ambient>0.3 0.18 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material></visual>
    </link>
    <link name="latch">
      <pose>-0.00005 -0.05225 -0.01375 0 0 0</pose>
      <inertial>
        <pose>-0.00761 -0.00978 0 0 0 0</pose>
        <mass>0.03</mass>
        <inertia><ixx>0.000926474</ixx><ixy>-0.000618971</ixy><ixz>-6.10079e-07</ixz><iyy>0.00177353</iyy><iyz>-1.48439e-07</iyz><izz>0.0024</izz></inertia>
      </inertial>
      <collision name="c3"><pose>0.03437 0.00003 0 -1.5708 0 1.57159</pose><geometry><cylinder><radius>0.01375</radius><length>0.06875</length></cylinder></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
      <visual name="v3"><pose>0.03437 0.00003 0 -1.5708 0 1.57159</pose><geometry><cylinder><radius>0.01375</radius><length>0.06875</length></cylinder></geometry><material><ambient>0.71 0.55 0.25 1</ambient><diffuse>0.71 0.55 0.25 1</diffuse></material></visual>
      <collision name="c4"><pose>0.05497 0.04129 0 0 0 1.57159</pose><geometry><box><size>0.0825 0.0165 0.022</size></box></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
      <visual name="v4"><pose>0.05497 0.04129 0 0 0 1.57159</pose><geometry><box><size>0.0825 0.0165 0.022</size></box></geometry><material><ambient>0.71 0.55 0.25 1</ambient><diffuse>0.71 0.55 0.25 1</diffuse></material></visual>
    </link>
    <joint name="frame_to_world" type="fixed"><parent>world</parent><child>door_frame</child></joint>
    <joint name="door_hinge" type="revolute">
      <parent>door_frame</parent><child>door_panel</child>
      <pose>-0.00011 0.14025 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0.0</lower><upper>1.5</upper></limit>
        <dynamics><damping>0.4</damping><friction>0.3</friction></dynamics>
      </axis>
    </joint>
    <joint name="handle_fixed" type="fixed"><parent>door_panel</parent><child>latch</child></joint>
  </model>
</sdf>
