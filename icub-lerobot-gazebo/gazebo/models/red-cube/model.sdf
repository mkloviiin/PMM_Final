<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="red-cube">
    <link name="link">
      <inertial>
        <mass>0.027</mass>
        <!-- Cubo sólido: I = m*a^2/6. Masa del cubo de apilado medido el 20-10-2026 (parametros_fisicos_objetos.txt), antes 0.1 kg -->
        <inertia>
          <ixx>1.125e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.125e-05</iyy>
          <iyz>0</iyz>
          <izz>1.125e-05</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <!-- Igual que las yemas del iCub (mu=5): sin esto el cubo usa el default (1)
             y DART toma el mínimo de ambas superficies, así que resbala al agarrar. -->
        <surface>
          <friction>
            <ode>
              <mu>5.0</mu>
              <mu2>5.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>  
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Contactos del cubo (gz.msgs.Contacts, solo mientras hay contacto) para el criterio
           de éxito de Block Stacking (robosuite Stack: el azul toca el rojo), que eval_gazebo.py
           lee con GzContactReader. Requiere gz-sim-contact-system en el mundo. -->
      <sensor name="contact" type="contact">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <contact>
          <collision>collision</collision>
          <topic>/red-cube/contact</topic>
        </contact>
      </sensor>
    </link>
    <!-- Pose del modelo en /model/<nombre>/pose (gz.msgs.Pose, mundo Gazebo) a 30 Hz:
         la lee el plugin lerobot_robot_icubrg (use_object_pose) como obj{i}_* del dataset. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>