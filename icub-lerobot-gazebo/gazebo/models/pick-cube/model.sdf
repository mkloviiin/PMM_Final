<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- pick-cube de la escena Pick-and-Place (scene_icub_pickplace.xml): cubo de 4 cm, 0.08 kg -->
  <model name="pick-cube">
    <link name="link">
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>2.1333e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.1333e-05</iyy><iyz>0</iyz>
          <izz>2.1333e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <!-- mu=5 como el blue-cube: DART toma el minimo con las yemas del iCub (mu=5) -->
        <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
    </link>
    <!-- Pose del modelo en /model/<nombre>/pose (gz.msgs.Pose, mundo Gazebo) a 30 Hz:
         la lee el plugin lerobot_robot_icubrg (use_object_pose) como obj{i}_* del dataset. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>
