<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="table">
    <!-- Mesa de 100 (ancho) x 60 (largo) x 72 (alto) cm. En el mundo se rota -90°:
         x del modelo (1.0 m) queda a lo ancho frente al iCub, y (0.6 m) en profundidad.
         Cubierta: centro a 0.705 m + 0.015 m de semiespesor = 0.72 m. -->
    <static>true</static>
    <link name="link">
      
      <collision name="surface">
        <pose>0 0 0.705 0 0 0</pose> <geometry>
          <box>
            <size>1.0 0.6 0.03</size>
          </box>
        </geometry>
      </collision>

      <visual name="surface_visual">
        <pose>0 0 0.705 0 0 0</pose> <geometry>
          <box>
            <size>1.0 0.6 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient> <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <!-- Patas grises como el acero cepillado de MuJoCo (gris ~0.5 en sRGB = 0.22 lineal) -->
      <visual name="leg1">
        <pose>0.45 0.25 0.345 0 0 0</pose> <geometry>
            <box><size>0.05 0.05 0.69</size></box> </geometry>
        <material> <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse> </material>
      </visual>

      <visual name="leg2">
        <pose>-0.45 0.25 0.345 0 0 0</pose>
        <geometry>
            <box><size>0.05 0.05 0.69</size></box>
        </geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse>
        </material>
      </visual>

      <visual name="leg3">
        <pose>0.45 -0.25 0.345 0 0 0</pose>
        <geometry>
            <box><size>0.05 0.05 0.69</size></box>
        </geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse>
        </material>
      </visual>

      <visual name="leg4">
        <pose>-0.45 -0.25 0.345 0 0 0</pose>
        <geometry>
            <box><size>0.05 0.05 0.69</size></box>
        </geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>