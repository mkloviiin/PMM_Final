<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- Mesa de MuJoCo (icub_standard_table.xml): tapa 0.5 x 0.8 x 0.05 m con la cara superior en z=0.72,
       patas de 0.05 m de diametro. Sin giro: x = profundidad (0.5), y = ancho (0.8).
       Se incluye en el mundo en x=-0.45 (0.45 m delante del iCub, que mira hacia -x). -->
  <model name="table">
    <static>true</static>
    <link name="link">
      <collision name="surface">
        <pose>0 0 0.695 0 0 0</pose>
        <geometry>
          <box><size>0.5 0.8 0.05</size></box>
        </geometry>
      </collision>
      <visual name="surface_visual">
        <pose>0 0 0.695 0 0 0</pose>
        <geometry>
          <box><size>0.5 0.8 0.05</size></box>
        </geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <visual name="leg1">
        <pose>0.15 0.3 0.3475 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <visual name="leg2">
        <pose>-0.15 0.3 0.3475 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <visual name="leg3">
        <pose>-0.15 -0.3 0.3475 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <visual name="leg4">
        <pose>0.15 -0.3 0.3475 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
