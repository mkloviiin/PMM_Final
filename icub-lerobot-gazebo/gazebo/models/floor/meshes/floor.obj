# Piso de 20 x 20 m centrado en el origen, en z = 0, normal +z.
# UV de 0 a 40: la textura se repite cada 0.5 m, igual que texrepeat="2 2" (texuniform)
# del material floorplane de MuJoCo (icub_shared_materials.xml).
v -10 -10 0
v 10 -10 0
v 10 10 0
v -10 10 0
vt 0 0
vt 40 0
vt 40 40
vt 0 40
vn 0 0 1
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
