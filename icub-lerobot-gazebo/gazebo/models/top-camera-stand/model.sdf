<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="top_camera_stand">
    <static>true</static>
    <!-- Sin <visual>, como camera-stand: la verían los ojos del iCub. -->
    <link name="link">
      <sensor name="top_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <!-- = fovy 58° de la topview de MuJoCo con aspecto 4:3 -->
          <horizontal_fov>1.273</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>top_camera/image</topic>
      </sensor>
    </link>

    <!-- En YARP como /icubSim/cam/top/rgbImage:o (mismo esquema que camera-stand). La graban
         solo las tareas que la piden (cameras en scenes.yaml, p. ej. la puerta). -->
    <plugin name="gzyarp::Camera" filename="gz-sim-yarp-camera-system">
      <yarpConfigurationString>(yarpDeviceName top_camera_rgb) (parentLinkName link) (sensorName top_camera) (framerate 30) (stamp 1)</yarpConfigurationString>
    </plugin>
    <plugin name="gzyarp::RobotInterface" filename="gz-sim-yarp-robotinterface-system">
      <yarpRobotInterfaceConfigurationFile>model://top-camera-stand/top_camera_nws.xml</yarpRobotInterfaceConfigurationFile>
    </plugin>
  </model>
</sdf>
