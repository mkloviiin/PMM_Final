<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="blue-cylinder">
    <link name="link">
      <inertial>
        <mass>0.5</mass>
        <!-- Cilindro sólido: ixx = iyy = m(3r^2 + h^2)/12, izz = m*r^2/2 -->
        <inertia>
          <ixx>5.2917e-04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.2917e-04</iyy>
          <iyz>0</iyz>
          <izz>2.25e-04</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <!-- Misma fricción que las yemas del iCub (ver blue-cube). -->
        <surface>
          <friction>
            <ode>
              <mu>5.0</mu>
              <mu2>5.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>