<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- lift-pot de Two-Arm Lifting (scene_icub_twoarmlift.xml): caja abierta de 14 cm con dos asas en T
       (verde y azul), 1.5 kg. Generado desde la geometria compilada de MuJoCo y definido ya en el marco
       de Gazebo (giro de 180 grados en z), asi que el asa verde queda del lado izquierdo del robot
       igual que en MuJoCo. Origen del modelo = origen del cuerpo en MuJoCo (se spawnea en z=0.795).
       mu=5 como los cubos: DART toma el minimo con las yemas del iCub. -->
  <model name="lift-pot">
    <link name="link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.006</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.006</iyy><iyz>0</iyz>
          <izz>0.004</izz>
        </inertia>
