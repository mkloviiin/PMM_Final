      <collision name="c0">
        <pose>0 0 -0.065 0 0 3.14159</pose>
        <geometry><box><size>0.14 0.14 0.01</size></box></geometry>
        <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
      </collision>
