<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">
    <physics name="1ms" type="ignored">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
        filename="gz-sim-contact-system"
        name="gz::sim::systems::Contact">
    </plugin>

    <!-- Sin sombras en toda la escena (además el sol no las proyecta, ver light "sun") -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- YARP CLOCK -->
    <plugin
        filename="gz-sim-yarp-clock-system"
        name="gzyarp::Clock">
    </plugin>

    <include>
      <uri>model://table</uri>
      <!-- Centro en x = -0.50: borde cercano a 0.20 m del iCub, igual que en MuJoCo -->
      <pose>-0.5 0 0 0 0 -1.57</pose>
    </include>

    <include>
      <uri>model://room</uri>
    </include>

    <!-- Table top at z=0.72, igual que la mesa de MuJoCo (icub_standard_table.xml) -->
    <include>
      <uri>model://blue-cube</uri>
      <pose>-0.4 0.1 0.745 0 0 0</pose>
    </include>

    <!-- Cámara frontal: réplica de la "frontview" de MuJoCo (icub_room_arena.xml,
         pos 1.6 0 1.0, 15° hacia abajo, fovy 45°) espejada en x porque aquí el iCub
         mira hacia -x. Publica en YARP /icubSim/cam/front/rgbImage:o (ver models/camera-stand). -->
    <include>
      <uri>model://camera-stand</uri>
      <name>camara_externa</name>
      <pose>-1.6 0 1.0 0 0.2618 0</pose>
    </include>

    <!-- Sol sin sombras. Mismos parámetros que el modelo Sun de Fuel (que antes se incluía con
         yaw 3.14 y cast_shadows true); la dirección ya va girada 180° en z. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.5 -0.1 -0.9</direction>
    </light>

    <include>
      <!-- Piso con textura (models/floor), igual al de la arena de MuJoCo -->
      <uri>model://floor</uri>
    </include>

    <state world_name='default'>
      <!-- <light name='sun'>
        <pose frame=''>0 0 10 0 -0 3.14</pose>
      </light> -->
    </state>

    <model name="iCub">
      <include>
        <uri>model://iCubGazeboV2_5_visuomanip_camada</uri>
        <!-- z = 0.73, igual que MuJoCo (cintura del iCub sobre su soporte, respecto de la mesa
             con tapa en 0.72). Antes 0.77: con 0.73 la initialConfiguration original de los
             brazos dejaba las puntas de los dedos ~0.4 cm dentro de la mesa y DART saturaba;
             ahora model.urdf arranca con el codo a 1.2 rad (dedo más bajo ~9 cm sobre la mesa). -->
        <pose>0.0 0.0 0.73 0.0 0.0 0.0</pose>
      </include>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-1.2 0 0.7 0 0 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>

