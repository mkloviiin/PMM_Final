<?xml version='1.0' encoding='utf-8'?>
<mujoco model="icub_standard_table">
  <!-- Mesa de 100 (ancho, y) x 60 (largo, x) x 72 (alto) cm, cubierta de 3 cm, borde cercano a
       0.20 m del robot (x de 0.20 a 0.80). Idéntica a gazebo/models/table en icub_world.sdf
       (allí espejada: x -> -x). Patas a 5 cm de los bordes. -->
  <worldbody>
    <body name="table" pos="0.5 0 0.705">
      <geom pos="0 0 0" size="0.3 0.5 0.015" type="box" group="0" name="table_collision" friction="1 0.005 0.0001" />
      <geom pos="0 0 0" size="0.3 0.5 0.015" type="box" conaffinity="0" contype="0" group="1" name="table_visual" material="table_ceramic" />
      <site pos="0 0 0.015" name="table_top" size="0.001 0.001 0.001" rgba="0 0 0 0" />
      <geom pos="0.25 0.45 -0.36" size="0.025 0.345" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg1_visual" material="table_legs_metal" />
      <geom pos="-0.25 0.45 -0.36" size="0.025 0.345" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg2_visual" material="table_legs_metal" />
      <geom pos="-0.25 -0.45 -0.36" size="0.025 0.345" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg3_visual" material="table_legs_metal" />
      <geom pos="0.25 -0.45 -0.36" size="0.025 0.345" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg4_visual" material="table_legs_metal" />
    </body>
  </worldbody>
</mujoco>
