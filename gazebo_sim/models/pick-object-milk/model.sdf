<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- GENERADO por src/tools/pickplace_assets.py: milk de robosuite PickPlace (pick-object de scene_icub_pickplace.xml) -->
  <model name="pick-object">
    <link name="link">
      <inertial>
        <mass>0.0227193</mass>
        <inertia><ixx>4.22459e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>4.22459e-05</iyy><iyz>0</iyz><izz>5.97413e-06</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.0397206 0.0397206 0.144</size></box></geometry>
        <!-- mu=5 como los cubos: DART toma el mínimo con las yemas del iCub (mu=5) -->
        <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>meshes/milk.obj</uri></mesh></geometry>
      </visual>
    </link>
    <!-- Pose del modelo en /model/<nombre>/pose (mundo Gazebo) a 30 Hz: la graba
         lerobot_robot_icubrg como obj{i}_* y la lee eval_policy.py (criterio de éxito). -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>
