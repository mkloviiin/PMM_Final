<?xml version="1.0" ?>
<sdf version="1.7">
  <!-- GENERADO por src/tools/pickplace_assets.py: réplica visual de bread en su compartimento de bin-target (sin colisión) -->
  <model name="visual-bread">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry><mesh><uri>meshes/bread.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
