      </collision>
      <collision name="latch_strike">
        <pose>0.038 0.0155 -0.01375 0 -0 0</pose>
        <geometry><box><size>0.046 0.007 0.003</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><collide_bitmask>2</collide_bitmask></contact>
        </surface>
      </collision>
      <collision name="latch_strike_mirror">
        <pose>0.292 0.0155 -0.01375 0 -0 0</pose>
        <geometry><box><size>0.046 0.007 0.003</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><collide_bitmask>2</collide_bitmask></contact>
        </surface>
      </collision>
      <visual name="r_frame_visual">
