    <link name="panel">
      <pose>-0.000131373 0.0439999 0 0 -0 1.57159</pose>
      <self_collide>true</self_collide>
      <inertial>
        <pose>0.0163 -0.00084 0 0 -0 1.58779</pose>
        <mass>0.4</mass>
        <inertia><ixx>0.0046</ixx><iyy>0.0026</iyy><izz>0.0022</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="panel_collision">
