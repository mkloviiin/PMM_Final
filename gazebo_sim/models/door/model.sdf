      </visual>
      <visual name="latch_tip_visual">
        <pose>-0.019 0.0265 0 0 -0 0</pose>
        <geometry><box><size>0.014 0.012 0.005</size></box></geometry>
        <material><ambient>0.523 0.319 0.0509 1</ambient><diffuse>0.523 0.319 0.0509 1</diffuse></material>
      </visual>
    </link>
    <joint name="door_hinge" type="revolute">
      <parent>frame</parent>
      <child>panel</child>
      <pose>0.14025 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>1.5</upper></limit>
        <dynamics><damping>0.4</damping><friction>0.3</friction></dynamics>
      </axis>
    </joint>
    <joint name="handle_hinge" type="revolute">
      <parent>panel</parent>
      <child>latch</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>-1.2</lower><upper>0</upper></limit>
        <dynamics><damping>0.03</damping><spring_reference>0</spring_reference><spring_stiffness>0.15</spring_stiffness></dynamics>
      </axis>
    </joint>
    <!-- door_hinge / handle_hinge en /world/default/model/door/joint_state (éxito en eval) -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </model>
</sdf>
