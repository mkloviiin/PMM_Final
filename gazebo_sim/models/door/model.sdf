        <geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><collide_bitmask>1</collide_bitmask></contact>
        </surface>
      </collision>
      <collision name="l_frame">
        <pose>0.02475 0 0 0 -0 0</pose>
        <geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry>
        <surface>
