        <geometry><cylinder><radius>0.0165</radius><length>0.33</length></cylinder></geometry>
        <material><ambient>0.107 0.0397 0.0134 1</ambient><diffuse>0.107 0.0397 0.0134 1</diffuse></material>
      </visual>
      <visual name="latch_strike_visual">
        <pose>0.038 0.0155 -0.01375 0 -0 0</pose>
        <geometry><box><size>0.046 0.007 0.003</size></box></geometry>
        <material><ambient>0.523 0.319 0.0509 1</ambient><diffuse>0.523 0.319 0.0509 1</diffuse></material>
