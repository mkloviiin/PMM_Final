<?xml version="1.0" ?>
<!-- GENERADO por tools/door_sdf_from_mujoco.py desde scene_icub_door.xml: no editar a mano.
     Origen = door_mount de MuJoCo; pose del fixture en Gazebo = (-0.47, 0.086, 0.885). -->
<sdf version="1.7">
  <model name="door">
    <!-- Sin esto gz-sim no choca piezas del mismo modelo (el pestillo con su traba) -->
    <self_collide>true</self_collide>
