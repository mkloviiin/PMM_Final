<?xml version='1.0' encoding='utf-8'?>
<mujoco model="scene_icub_peginhole">

  <include file="icub_visuomanip_ikin_limits.xml"/>
  <include file="icub_shared_materials.xml"/>
  <include file="icub_room_arena.xml"/>
  <include file="icub_standard_table.xml"/>

  <visual>
    <map force="0.1" zfar="30" />
    <rgba haze="0.15 0.25 0.35 1" />
    <quality shadowsize="2048" />
    <global offwidth="800" offheight="800" />
  </visual>

  <worldbody>
    <!-- Tabla con agujero al alcance de la mano derecha y la clavija de pie a la derecha
         (acostada, pararla exige girar la muñeca 90°, que el iCub no da). Tabla de
         16 x 16 x 2 cm sobre la mesa, agujero de 6 x 6 cm centrado en el body. -->
    <body name="hole-board" pos="0.36 0.0 0.73">
      <geom pos="0.055 0 0" size="0.025 0.08 0.01" type="box" group="1" material="plate_mat" />
      <geom pos="-0.055 0 0" size="0.025 0.08 0.01" type="box" group="1" material="plate_mat" />
      <geom pos="0 0.055 0" size="0.03 0.025 0.01" type="box" group="1" material="plate_mat" />
      <geom pos="0 -0.055 0" size="0.03 0.025 0.01" type="box" group="1" material="plate_mat" />
      <site name="hole_center" pos="0 0 0" size="0.003" rgba="1 0 0 0" />
    </body>
    <!-- Clavija de pie: cilindro de 4 cm de diámetro y 13 cm de alto -->
    <body name="peg" pos="0.32 -0.22 0.785" quat="0 0 0 1">
      <inertial pos="0 0 0" mass="0.12" diaginertia="0.0002 0.0002 0.00005" />
      <geom type="cylinder" size="0.02 0.065" group="0" name="peg_collision" rgba="0.6 0.6 0.15 1" friction="0.9 0.01 0.001" condim="4" />
      <geom type="cylinder" size="0.02 0.065" conaffinity="0" contype="0" group="1" name="peg_visual" rgba="0.6 0.6 0.15 1" />
      <freejoint />
    </body>
  </worldbody>

</mujoco>
