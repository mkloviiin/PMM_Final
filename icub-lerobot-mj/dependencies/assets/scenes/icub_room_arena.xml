    <!-- Misma luz que Gazebo (sol de icub_world.sdf, dirección espejada en x/y), sin sombras.
         Intensidades calibradas contra imágenes de Gazebo (mesa, piso, cubo, paredes): con los
         mismos valores nominales MuJoCo sale más claro, porque no aplica el tono de Ogre2. -->
    <light name="sun" pos="1.0 1.0 1.5" dir="-0.5 0.1 -0.9" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" directional="true" castshadow="false" />
    <!-- Frontal: frente al robot, 0.23 m sobre la mesa y 8° hacia abajo: la imagen parte en la
         superficie de la mesa (los objetos) y hacia arriba el robot, sin patas ni piso.
         Gazebo: camara_externa en icub_world.sdf. -->
    <camera mode="fixed" name="frontview" pos="1.2 0 0.95" xyaxes="0 1 0 -0.1392 0 0.9903" fovy="45" />
    <camera mode="fixed" name="birdview" pos="1.2 0 4.0" quat="0.7071 0 0 0.7071" />
    <camera mode="fixed" name="agentview" pos="0.5 0 1.35" quat="0.653 0.271 0.271 0.653" />
    <!-- Cenital: recta hacia abajo (fácil de montar igual en el robot real), 0.83 m sobre la
         mesa y centrada en la zona de trabajo; mesa y manos completas, robot arriba en la imagen
         y su izquierda a la derecha. La graba la tarea de la puerta como cámara "top" (cameras
         en scenes.yaml). -->
    <camera mode="fixed" name="topview" pos="0.36 0 1.55" xyaxes="0 1 0 -1 0 0" fovy="58" />
    <camera mode="fixed" name="sideview" pos="-0.05651774593317116 0.70 1.4879572214102434" quat="0.009905065491771751 0.006877963156909582 0.5912228352893879 0.806418094001364" />
  </worldbody>

  <visual>
    <!-- Sin luz pegada a la cámara (Gazebo no la tiene): solo su componente ambiente, que hace
         de luz ambiente de la escena (la de Gazebo es la de <scene>). -->
    <headlight ambient="0.3 0.3 0.3" diffuse="0 0 0" specular="0 0 0" />
  </visual>
