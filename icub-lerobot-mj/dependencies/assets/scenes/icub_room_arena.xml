<mujoco model="icub_room_arena">
  <!-- Cuarto del HUB (3ra sala), medidas del plano "Espacio para el HUB" (08-09-2026).
       Largo 7.13 m, ancho 1.65 -> 1.20 m (muro inclinado en 3 tramos), alto 2.5 m.
       Marco: el robot esta en el origen mirando +x; +y es su izquierda. Giros con quat (el robot compila en radianes).
       Muro de abajo con 3 puertas de 913.57 mm. Muros solo visuales (sin colision). -->
  <asset>
    <!-- Mural AC3E (icub-lerobot-gazebo/gazebo/wall.png) en la pared derecha del iCub, como en Gazebo.
         emission 0.74: esa cara recibe ~0.26 de luz en frontview/head_cam; suma ~1 = colores de la imagen. -->
    <texture name="tex-wall-ac3e" type="2d" file="../textures/wall_ac3e.png" />
    <material name="wall_mural" texture="tex-wall-ac3e" rgba="1 1 1 1" specular="0" shininess="0" reflectance="0" emission="0.74" />
    <mesh name="wall_right_mural" file="../room/wall_right.obj" inertia="shell" />
  </asset>
