<?xml version='1.0' encoding='utf-8'?>
<mujoco model="scene_icub_door">

  <include file="icub_visuomanip_ikin_limits.xml"/>
  <include file="icub_shared_materials.xml"/>
  <include file="icub_room_arena.xml"/>
  <include file="icub_standard_table.xml"/>

  <visual>
    <map force="0.1" zfar="30" />
    <rgba haze="0.15 0.25 0.35 1" />
    <quality shadowsize="2048" />
    <global offwidth="800" offheight="800" />
  </visual>

  <worldbody>
    <!-- Puerta de "Door Opening" (escenario final): manilla a la izquierda del robot, se abre
         con la mano derecha (cruza poco: la puerta está corrida hacia el brazo derecho, así que
         el torso, limitado como en el robot real, casi no trabaja). Centro de la hoja en
         (0.47, -0.13): bisagra en y=-0.27 (derecha), manilla en y~-0.075. La puerta abre hacia
         el robot; door_hinge > 0 = abierta. Es la orientación de la puerta original de
         robosuite (door_mount (0.42, 0.15)); dependencies/door_scene.py la espeja (manilla a la
         derecha) y la mueve en tiempo de ejecución.

         Pestillo (como use_latch de robosuite): latch_tip, detrás de la puerta, choca con
         latch_strike del marco y la traba cerrada. Bajar la manilla (handle_hinge < 0, eje
         del cilindro de la manilla) sube latch_tip; desde ~-0.33 rad (19 deg) pasa sobre
         latch_strike y la puerta abre. El resorte de la manilla la devuelve a 0. -->
    <body name="door_mount" pos="0.47 -0.086 0.885">
      <body name="object">
        <body name="door_frame" pos="0 0.121 0" quat="0.707388 0 0 -0.706825">
          <inertial pos="0.165 0 0" quat="0.5 0.5 0.5 0.5" mass="1.3" diaginertia="0.0465 0.0385 0.0085" />
          <geom size="0.0165 0.165" pos="0.30525 0 0" type="cylinder" group="1" name="r_frame" material="door_wood" />
          <geom size="0.0165 0.165" pos="0.02475 0 0" type="cylinder" group="1" name="l_frame" material="door_wood" />
          <geom size="0.023 0.0035 0.0015" pos="0.038 0.0155 -0.01375" type="box" group="0" contype="2" conaffinity="2" name="latch_strike" material="door_handle_metal" />
          <!-- Espejo, para la manilla a la derecha (dependencies/door_scene.py) -->
          <geom size="0.023 0.0035 0.0015" pos="0.292 0.0155 -0.01375" type="box" group="0" contype="2" conaffinity="2" name="latch_strike_mirror" material="door_handle_metal" />
          <body name="door_panel" pos="0.165 0 0">
            <inertial pos="0.0163 -0.00084 0" quat="0.701072 0 0 0.713091" mass="0.4" diaginertia="0.0046 0.0026 0.0022" />
            <joint name="door_hinge" pos="0.14025 0 0" axis="0 0 1" range="0.0 1.5" damping="0.4" frictionloss="0.3" />
            <geom size="0.121 0.011 0.1595" type="box" friction="1 1 1" group="0" name="panel_collision" material="door_wood" />
            <body name="latch" pos="-0.09625 0 -0.01375">
              <inertial pos="-0.00977 0.00762 0" quat="0.365653 0.605347 -0.36522 0.605365" mass="0.03" diaginertia="0.0024 0.0021 0.0006" />
              <geom fromto="0 0 0 0 -0.06875 0" size="0.01375" type="cylinder" group="1" name="handle_base" material="door_handle_metal" />
              <geom size="0.04125 0.00825 0.011" pos="0.04125 -0.055 0" type="box" group="0" name="handle_collision" material="door_handle_metal" />
              <geom size="0.007 0.006 0.0025" pos="-0.019 0.0265 0" type="box" group="0" contype="2" conaffinity="2" name="latch_tip" material="door_handle_metal" />
              <joint name="handle_hinge" pos="0 0 0" axis="0 -1 0" range="-1.2 0" damping="0.03" stiffness="0.15" />
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

</mujoco>
