<?xml version='1.0' encoding='utf-8'?>
<mujoco model="scene_icub_stack">

  <include file="icub_visuomanip_ikin_limits.xml"/>
  <include file="icub_shared_materials.xml"/>
  <include file="icub_room_arena.xml"/>
  <include file="icub_standard_table.xml"/>

  <visual>
    <map force="0.1" zfar="30" />
    <rgba haze="0.15 0.25 0.35 1" />
    <quality shadowsize="2048" />
    <global offwidth="800" offheight="800" />
  </visual>

  <worldbody>
    <!-- Cubos como el de scene_icub_lift.xml (y gazebo_sim/models/blue-cube, red-cube): inercia
         m*a^2/6 y fricción 5. Con fricción 1 e inercia ~15 veces mayor la mano no los levanta.
         Masas medidas el 20-10-2026 (parametros_fisicos_objetos.txt; antes 0.1 kg): cubos de
         apilado 0.027 kg. El azul usa los valores del cubo de Block Lifting (0.028 kg) porque
         en Gazebo las dos tareas comparten el modelo blue-cube. -->
    <body name="blue-cube" pos="0.4 -0.12 0.745" quat="0 0 0 1">
      <inertial pos="0 0 0" mass="0.028" diaginertia="1.1667e-05 1.1667e-05 1.1667e-05" />
      <geom type="box" size="0.025 0.025 0.025" group="0" name="blue_cube_collision" friction="5 0.005 0.0001" />
      <geom type="box" size="0.025 0.025 0.025" conaffinity="0" contype="0" group="1" name="blue_cube_visual" material="blue" />
      <freejoint />
    </body>
    <body name="red-cube" pos="0.4 0.06 0.745" quat="0 0 0 1">
      <inertial pos="0 0 0" mass="0.027" diaginertia="1.125e-05 1.125e-05 1.125e-05" />
      <geom type="box" size="0.025 0.025 0.025" group="0" name="red_cube_collision" friction="5 0.005 0.0001" />
      <geom type="box" size="0.025 0.025 0.025" conaffinity="0" contype="0" group="1" name="red_cube_visual" material="red" />
      <site name="stack_target_top" pos="0 0 0.026" size="0.002 0.002 0.002" rgba="1 0 0 0" />
      <freejoint />
    </body>
  </worldbody>

  <contact>
    <!-- Como scene_icub_lift.xml: con los cubos en fricción 5 (para agarrarlos) MuJoCo combina
         con el máximo y, con el cono piramidal, se hunden ~3 cm en la mesa. Estos pares dejan
         cubo-mesa y cubo-cubo en 1 (Gazebo/DART usa el mínimo de las dos superficies). -->
    <pair geom1="blue_cube_collision" geom2="table_collision" friction="1 1 0.005 0.0001 0.0001"/>
    <pair geom1="red_cube_collision" geom2="table_collision" friction="1 1 0.005 0.0001 0.0001"/>
    <pair geom1="blue_cube_collision" geom2="red_cube_collision" friction="1 1 0.005 0.0001 0.0001"/>
  </contact>

</mujoco>
