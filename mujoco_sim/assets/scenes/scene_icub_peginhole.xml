<?xml version='1.0' encoding='utf-8'?>
<mujoco model="scene_icub_peginhole">

  <include file="icub_visuomanip_ikin_limits.xml"/>
  <include file="icub_shared_materials.xml"/>
  <include file="icub_room_arena.xml"/>
  <include file="icub_standard_table.xml"/>

  <visual>
    <map force="0.1" zfar="30" />
    <rgba haze="0.15 0.25 0.35 1" />
    <quality shadowsize="2048" />
    <global offwidth="800" offheight="800" />
  </visual>

  <worldbody>
    <!-- Two-Arm Peg-In-Hole al estilo de robosuite (TwoArmPegInHole): la mano derecha toma la
         tabla y la levanta, la izquierda toma la clavija de pie, la gira hasta dejarla
         horizontal y la pasa de lado por el agujero, en el aire. En robosuite los objetos
         vienen pegados a las pinzas; acá hay que tomarlos de la mesa.

         Tabla vertical (plano x-z) de 18 x 18 x 3 cm, de pie sobre su canto, con agujero de
         6 x 6 cm (centro del body) que apunta en y, hacia las manos. Sin mango (hasta el
         2026-10-26 tenía un bloque de 5 cm arriba y medía 12 x 12 cm): se toma por un canto.
         Simétrica en x e y, así que el giro de 180° en z de los objetos (scenes.yaml) no la
         cambia. Sin fabricar: ~0.12 kg como antes, con density para que la inercia salga de la
         geometría. Delante de las manos en home (scenes.yaml), para que no las toque al aparecer. -->
    <body name="hole-board" pos="0.41 -0.06 0.81" quat="0 0 0 1">
      <geom pos="0.06 0 0" size="0.03 0.015 0.09" type="box" group="1" material="plate_mat" density="139" friction="1.0 0.005 0.0001" condim="4" />
      <geom pos="-0.06 0 0" size="0.03 0.015 0.09" type="box" group="1" material="plate_mat" density="139" friction="1.0 0.005 0.0001" condim="4" />
      <geom pos="0 0 0.06" size="0.03 0.015 0.03" type="box" group="1" material="plate_mat" density="139" friction="1.0 0.005 0.0001" condim="4" />
      <geom pos="0 0 -0.06" size="0.03 0.015 0.03" type="box" group="1" material="plate_mat" density="139" friction="1.0 0.005 0.0001" condim="4" />
      <site name="hole_center" pos="0 0 0" size="0.003" rgba="1 0 0 0" />
      <freejoint />
    </body>
    <!-- Clavija de pie, a la izquierda de la tabla y más cerca del robot (scenes.yaml): cilindro de
         4 cm de diámetro y 13 cm de alto. La izquierda
         la toma de costado por el centro y la gira 90° (palma abajo) para pasarla por el agujero:
         el IK del brazo izquierdo llega a esa orientación igual de bien que al agarre de costado
         (con la palma arriba no). Masa medida el 20-10-2026 (parametros_fisicos_objetos.txt): 0.027 kg,
         inercia de cilindro sólido (z = eje). -->
    <body name="peg" pos="0.35 0.08 0.785" quat="0 0 0 1">
      <inertial pos="0 0 0" mass="0.027" diaginertia="4.0725e-05 4.0725e-05 5.4e-06" />
      <geom type="cylinder" size="0.02 0.065" group="0" name="peg_collision" rgba="0.6 0.6 0.15 1" friction="0.9 0.01 0.001" condim="4" />
      <geom type="cylinder" size="0.02 0.065" conaffinity="0" contype="0" group="1" name="peg_visual" rgba="0.6 0.6 0.15 1" />
      <freejoint />
    </body>
  </worldbody>

</mujoco>
